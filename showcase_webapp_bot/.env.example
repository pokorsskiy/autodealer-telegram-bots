BOT_TOKEN=токен_от_BotFather
YOUR_CHAT_ID=123456789
WEB_APP_URL=https://example.com
DB_NAME=showcase_webapp_leads.db
# Обязательно: 1 — демо, заявки не принимаются; 0 — рабочая витрина заказчика.
DEMO_MODE=
# Владелец сайта для подвала: ФИО или название компании и почта.
SITE_OWNER=
SITE_EMAIL=
# Необязательно: адрес посредника к Bot API для сервера в России, например https://tg.example.ru.
TELEGRAM_API_URL=
# 0 — уведомление о заявке без имени и телефона клиента, контакты — в админке. По умолчанию 1.
LEAD_NOTIFY_CONTACTS=
# Необязательно: Telegram file_id обложки после первой отправки локального файла.
MENU_COVER_FILE_ID=

# Первоначальный владелец создаётся только если владельцев в БД ещё нет.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=замените_на_длинный_пароль_не_менее_12_символов
# Учётная запись разработчика создаётся только если разработчиков в БД ещё нет.
# Разработчик управляет всеми учётными записями, включая владельцев.
DEVELOPER_USERNAME=
DEVELOPER_PASSWORD=
# Вход в админку из Telegram без пароля (команда /admin): Telegram_ID:логин через запятую.
ADMIN_TELEGRAM_IDS=
# Токены других ботов, из которых открывают эту админку (гибрид), через запятую.
# В их чаты тоже приходят заявки с сайта.
ADMIN_EXTRA_BOT_TOKENS=
SECRET_KEY=замените_на_случайную_строку_не_менее_32_символов

WEB_HOST=127.0.0.1
WEB_PORT=8000
SESSION_COOKIE_SECURE=1

# Ссылки для витрины: пустое значение прячет кнопку.
# Telegram можно указывать как @username, t.me/username или полный HTTPS-адрес.
TELEGRAM_CHANNEL_URL=
REVIEWS_URL=
COMMUNITY_URL=
MAX_URL=
VK_URL=
YOUTUBE_URL=
