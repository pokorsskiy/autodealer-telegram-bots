BOT_TOKEN=
YOUR_CHAT_ID=
WEB_APP_URL=https://example.com/webapp
MANAGER_URL=https://t.me/your_manager
# Кому /admin присылает кнопку админки: Telegram ID через запятую.
ADMIN_TELEGRAM_IDS=
DB_NAME=showcase_hybrid_leads.db
# Обязательно: 1 — демо, заявки никуда не отправляются; 0 — рабочий бот заказчика.
DEMO_MODE=
# Необязательно: адрес посредника к Bot API для сервера в России, например https://tg.example.ru.
TELEGRAM_API_URL=
# 0 — уведомление о заявке без имени и телефона клиента, контакты — в админке. По умолчанию 1.
LEAD_NOTIFY_CONTACTS=
# Необязательно: Telegram file_id обложки после первой отправки локального файла.
MENU_COVER_FILE_ID=

REVIEWS_URL=
COMMUNITY_URL=
TELEGRAM_CHANNEL_URL=
MAX_URL=
VK_URL=
YOUTUBE_URL=
