# Токен Telegram-бота, полученный через @BotFather.
BOT_TOKEN=

# file_id обложки меню. Появится в логе после первой отправки обложки.
MENU_COVER_FILE_ID=

# Репозиторий проекта для кнопки «Исходный код», полный https-адрес. Пустой — кнопки нет.
REPO_URL=

# Демо-админка Web App без входа, полный https-адрес. Пустая — кнопки в карточках нет.
ADMIN_DEMO_URL=

# Ссылки на боты-примеры: @username, t.me/username или полный адрес.
# Пустая ссылка — пример показывается без кнопки запуска.
TELEGRAM_SHOWCASE_URL=
WEBAPP_SHOWCASE_URL=
HYBRID_SHOWCASE_URL=

# Видео в карточках примеров: file_id из лога витрины (см. README).
# Пустое значение — карточка показывается текстом, без видео.
TELEGRAM_SHOWCASE_VIDEO_ID=
WEBAPP_SHOWCASE_VIDEO_ID=
HYBRID_SHOWCASE_VIDEO_ID=
